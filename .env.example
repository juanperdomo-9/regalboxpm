# Copiá este archivo como ".env" y completá los valores reales.
# El archivo ".env" NUNCA se sube a ningún repositorio (ver .gitignore).

# API key de Groq (gratis, sin tarjeta) para el Gift Finder con IA.
# Se genera en https://console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY=

# True en tu PC. En el hosting de producción (Render) se define en False
# desde el panel de variables de entorno, no acá.
DEBUG=True

# ---------------------------------------------------------------------
# Las siguientes SOLO hacen falta en producción (se cargan en el panel
# de variables de entorno de Render, no en este archivo local):
# ---------------------------------------------------------------------

# Clave secreta de Django. Generar una propia y pegarla en Render
# (no reutilizar la de desarrollo). Se puede generar con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# SECRET_KEY=

# Dominios permitidos, separados por coma. Ej:
# ALLOWED_HOSTS=regalboxx.onrender.com

# Mismo dominio pero con esquema https, para que Django acepte POSTs
# (login del admin, formularios) detrás de HTTPS. Ej:
# CSRF_TRUSTED_ORIGINS=https://regalboxx.onrender.com

# Connection string de Postgres (la da Neon al crear la base). Ej:
# DATABASE_URL=postgresql://usuario:password@host/nombre_db?sslmode=require

# API Environment variable completa de Cloudinary (Dashboard -> arriba a
# la derecha). Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_URL=
